# replay | live
# Replay is deterministic and requires no WorldMonitor/API keys.
JARVIS_SIGNAL_LAYER_MODE=replay

# Signal Layer HTTP service
SIGNAL_LAYER_PORT=8787
# Local-only by default. Set to 0.0.0.0 to expose on the LAN (only do this with
# SIGNAL_LAYER_API_TOKEN set — the service is otherwise unauthenticated).
SIGNAL_LAYER_HOST=127.0.0.1
# Optional bearer token. When set, every request (except GET /healthz) must send
# `Authorization: Bearer <token>`. Leave empty for the local replay demo.
SIGNAL_LAYER_API_TOKEN=
# Extra browser origins allowed for CORS beyond localhost/127.0.0.1/::1 (comma-separated).
SIGNAL_LAYER_ALLOWED_ORIGINS=

# WorldMonitor sidecar
# Keep this off :3000 because Jarvis's existing WorldView frontend owns :3000.
WORLDMONITOR_BASE_URL=http://localhost:3100
WORLDMONITOR_MCP_URL=http://localhost:3100/api/mcp
WORLDMONITOR_TIMEOUT_MS=8000

# Demo/UI
NEXT_PUBLIC_SIGNAL_LAYER_URL=http://localhost:8787
VITE_SIGNAL_LAYER_URL=http://localhost:8787

{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "strict": false,
    "noImplicitAny": false,
    // Pin the app gate to the DOM lib only. Without this, an unspecified
    // `types` means "every node_modules/@types/* package", so adding
    // @types/node for tsconfig.e2e.json would silently make `process.env`
    // type-check inside src/ — where the served bundle has no `process`.
    "types": [],
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src"]
}

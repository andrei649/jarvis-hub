{
  "permissions": {
   "allow": [
     "Bash(python scripts/selfdev_policy.py:*)",
     "Bash(python3 scripts/selfdev_policy.py:*)"
   ]
 },
  "extraKnownMarketplaces": {
    "superpowers-dev": {
      "source": "./.claude/plugins/superpowers"
    }
  },
  "enabledPlugins": {
    "superpowers@superpowers-dev": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis Hub",
  "version": "0.9.2",
  "identifier": "com.jarvis.hub",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:8080"
  },
  "app": {
    "windows": [
      {
        "title": "Jarvis Hub",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "url": "http://127.0.0.1:8080/"
      }
    ],
    "security": { "csp": null },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "Jarvis Hub",
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}

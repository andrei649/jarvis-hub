{
  "schema_version": 1,
  "policy_id": "nerva.selfdev.v1",
  "owner_directive_date": "2026-10-26",
  "autonomous_default": true,
  "description": "The owner authorizes autonomous development across the entire repository, including kernel, security, workflows and this policy, without further owner approval. Since the owner directive of 2026-10-26 (merge.protected_merge_directive) that authorization covers unattended MERGE as well: a change touching a protected path is still classified and recorded as control-plane, but it merges when the pinned automated proof set and every other reported check are green on a CLEAN non-draft head. The remaining guard is structural: validate_policy refuses a policy without the mandatory protected paths, the check floor or the deploy/rollback invariants, and the hourly workflow fails closed on an invalid trusted policy instead of merging with it. Autonomous deployment remains a target until its enforcement lands.",
  "local_development": {
    "enabled": true,
    "allow_protected_changes": true,
    "require_owner_approval": false
  },
  "protected_paths": [
    "selfdev-policy.json",
    "scripts/selfdev_policy.py",
    ".github/workflows/**",
    ".github/actions/**",
    ".github/CODEOWNERS",
    "AGENTS.md",
    "MAX.md",
    "MOONSHOT.md",
    "NERVA_VISION.md",
    "LICENSE",
    "TRADEMARKS.md",
    "docs/legal/**",
    "agents/core/kernel/**",
    "agents/core/security/**",
    "agents/core/secrets/**",
    "agents/core/secret*"
  ],
  "merge": {
    "enabled": true,
    "require_non_draft": true,
    "require_clean_merge_state": true,
    "require_at_least_one_check": true,
    "require_all_reported_checks_pass": true,
    "required_check_names": [
      "test (ubuntu-latest)",
      "hud-v2-build",
      "Secret scan (gitleaks)",
      "SAST (semgrep)",
      "Dependency audit (pip-audit)",
      "SAST (bandit — blocking gate)",
      "in-sync"
    ],
    "required_check_conclusions": [
      "success",
      "neutral"
    ],
    "other_check_conclusions": [
      "success",
      "neutral",
      "skipped"
    ],
    "deny_protected_changes": false,
    "protected_merge_directive": {
      "date": "2026-10-26",
      "owner": "andrei649",
      "statement": "Scoate și gate-ul din control_plane pentru auto-merge; vreau să poată fi dezvoltat autonom, fără intervenția mea."
    },
    "method": "squash"
  },
  "deploy": {
    "enabled": false,
    "target_enabled": true,
    "strategy": "staged_canary",
    "deny_protected_changes": true,
    "require_versioned_artifact": true,
    "require_post_deploy_probe": true,
    "auto_promote_on_green": true,
    "auto_rollback_on_regression": true
  },
  "review": {
    "independent_reviewer_required": false,
    "target_independent_reviewer_required": true,
    "builder_may_clear_own_findings": false,
    "security_review_patterns": [
      "agents/core/security/**",
      "agents/core/kernel/**",
      ".github/workflows/**"
    ]
  },
  "budgets": {
    "max_repair_attempts_per_change": 3,
    "max_wall_minutes_per_change": 180,
    "max_parallel_selfdev_changes": 4
  },
  "provenance": {
    "required": true,
    "required_fields": [
      "trigger",
      "proposal",
      "builder_model",
      "builder_session",
      "reviewer_model",
      "tests",
      "head_sha",
      "merge_sha",
      "deployment_artifact",
      "post_deploy_verdict"
    ]
  }
}

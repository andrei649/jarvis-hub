  "rewrite_rules": [
    {
      "id": "httpx",
      "pattern": "^(?P<i>[ \\t]*)import httpx(?P<rest>[ \\t]*(?:#.*)?)$",
      "replacement": "\\g<i>from agents.vendor.hermes_compat import httpx\\g<rest>",
      "why": "the compat httpx sends every request through Nerva's PluginHTTPClient"
    },
    {
      "id": "os-env",
      "pattern": "^(?P<i>[ \\t]*)import os(?P<rest>[ \\t]*(?:#.*)?)$",
      "replacement": "\\g<i>from agents.vendor.hermes_compat import os_env as os\\g<rest>",
      "why": "env reads go through an allowlist on agents.core.env_config"
    },
    {
      "id": "web-search-provider",
      "pattern": "^(?P<i>[ \\t]*)from agent\\.web_search_provider import ",
      "replacement": "\\g<i>from agents.vendor.hermes_compat.web_search_provider import ",
      "why": "the WebSearchProvider base and the secret-scoped key lookup"
    },
    {
      "id": "keyless-mcp",
      "pattern": "^(?P<i>[ \\t]*)from plugins\\.web\\.keyless_mcp import ",
      "replacement": "\\g<i>from agents.vendor.hermes_compat.keyless_mcp import ",
      "why": "the anonymous keyless ring stays off in Nerva"
    },
    {
      "id": "plugins-web",
      "pattern": "^(?P<i>[ \\t]*)from plugins\\.web\\.",
      "replacement": "\\g<i>from agents.vendor.hermes.plugins.web.",
      "why": "vendored siblings live under agents.vendor.hermes"
    },
    {
      "id": "interrupt",
      "pattern": "^(?P<i>[ \\t]*)from tools\\.interrupt import ",
      "replacement": "\\g<i>from agents.vendor.hermes_compat.interrupt import ",
      "why": "Hermes's interrupt flag (Nerva's e-stop acts at egress)"
    },
    {
      "id": "web-tools-slots",
      "pattern": "^(?P<i>[ \\t]*)import tools\\.web_tools as ",
      "replacement": "\\g<i>import agents.vendor.hermes_compat.web_tools as ",
      "why": "the SDK client cache slots"
    },
    {
      "id": "pm",
      "pattern": "^(?P<i>[ \\t]*)import pm(?P<rest>[ \\t]*(?:#.*)?)$",
      "replacement": "\\g<i>from agents.vendor.hermes_compat import pm\\g<rest>",
      "why": "lazy installs are refused; only the compat SDK stand-ins are provided"
    },
    {
      "id": "exa-sdk",
      "pattern": "^(?P<i>[ \\t]*)from exa_py import ",
      "replacement": "\\g<i>from agents.vendor.hermes_compat.sdk.exa_py import ",
      "why": "the Exa SDK is a bare client; the stand-in dials through the compat httpx"
    },
    {
      "id": "parallel-sdk",
      "pattern": "^(?P<i>[ \\t]*)import parallel(?P<rest>[ \\t]*(?:#.*)?)$",
      "replacement": "\\g<i>from agents.vendor.hermes_compat.sdk import parallel\\g<rest>",
      "why": "the Parallel SDK is a bare client; the stand-in dials through the compat httpx"
    },
    {
      "id": "exa-integration-tag",
      "pattern": "^(?P<i>[ \\t]*)client\\.headers\\[\"x-exa-integration\"\\] = \"hermes-agent\"(?P<rest>[ \\t]*(?:#.*)?)$",
      "replacement": "\\g<i>client.headers[\"x-exa-integration\"] = \"nerva\"\\g<rest>",
      "why": "tell Exa the caller is Nerva, not Hermes Agent"
    },
    {
      "id": "providers-base",
      "pattern": "^(?P<i>[ \\t]*)from providers\\.base import ",
      "replacement": "\\g<i>from agents.vendor.hermes.providers.base import ",
      "why": "the vendored ProviderProfile base"
    },
    {
      "id": "providers-registry",
      "pattern": "^(?P<i>[ \\t]*)from providers import ",
      "replacement": "\\g<i>from agents.vendor.hermes_compat.providers import ",
      "why": "register_provider fills the compat registry; Nerva's bridge reads it"
    },
    {
      "id": "reasoning-effort",
      "pattern": "^(?P<i>[ \\t]*)from agent\\.reasoning_effort import ",
      "replacement": "\\g<i>from agents.vendor.hermes.agent.reasoning_effort import ",
      "why": "the vendored effort vocabulary (pure)"
    },
    {
      "id": "reasoning-effort-module",
      "pattern": "^(?P<i>[ \\t]*)from agent import reasoning_effort\\b",
      "replacement": "\\g<i>from agents.vendor.hermes.agent import reasoning_effort",
      "why": "the vendored effort vocabulary, imported as a module"
    },
    {
      "id": "account-usage",
      "pattern": "^(?P<i>[ \\t]*)from agent\\.account_usage import ",
      "replacement": "\\g<i>from agents.vendor.hermes_compat.account_usage import ",
      "why": "a type name only; Nerva keeps its own usage accounting"
    },
    {
      "id": "hermes-cli-leaf",
      "pattern": "^(?P<i>[ \\t]*)from hermes_cli\\.(?:version_info|auth|urllib_security|chat_catalog) import ",
      "replacement": "\\g<i>from agents.vendor.hermes_compat.hermes_cli import ",
      "why": "user agent, credential pool, catalog fetch: Nerva-owned or refused"
    },
    {
      "id": "threading-locks",
      "pattern": "^(?P<i>[ \\t]*)import threading(?P<rest>[ \\t]*(?:#.*)?)$",
      "replacement": "\\g<i>from agents.vendor.hermes_compat import locks as threading\\g<rest>",
      "why": "locks only; vendored code starts no thread"
    },
    {
      "id": "urllib-request",
      "pattern": "^(?P<i>[ \\t]*)import urllib\\.request(?P<rest>[ \\t]*(?:#.*)?)$",
      "replacement": "\\g<i>from agents.vendor.hermes_compat import urllib_refused as urllib\\g<rest>",
      "why": "a request object only; opening one is refused (catalog fetches are Nerva's)"
    }
  ],

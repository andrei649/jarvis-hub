        state = {"now": 0, "max": 0}
    
        class Counting(FakeBackend):
            async def generate(self, model, prompt, **kw):
                state["now"] += 1
                state["max"] = max(state["max"], state["now"])
                self.calls.append(prompt)
                try:
                    await asyncio.sleep(0.005)
                finally:
                    state["now"] -= 1
                return GOOD
    

# Jarvis Hub — systemd service unit (Linux). (H23.15)
#
# Install (edit the paths/User first — see deploy/systemd/README.md):
#   sudo cp deploy/systemd/jarvis-hub.service /etc/systemd/system/
#   sudo cp deploy/systemd/jarvis-hub.env     /etc/jarvis-hub/jarvis.env   # optional overrides
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now jarvis-hub
#   systemctl status jarvis-hub   ·   journalctl -u jarvis-hub -f
#
# Graceful shutdown ties into H23.11: uvicorn handles SIGTERM, runs the FastAPI
# lifespan teardown (channels stopped, pooled clients closed) bounded by
# JARVIS_SHUTDOWN_TIMEOUT. TimeoutStopSec below is set a few seconds LONGER than
# that drain budget so systemd lets the app finish before it sends SIGKILL.

[Unit]
Description=Jarvis Hub — personal AI cabinet (FastAPI)
Documentation=https://github.com/andrei649/jarvis-hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ── EDIT THESE for your install ──────────────────────────────────────────────
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis-hub
ExecStart=/opt/jarvis-hub/.venv/bin/python serve.py
# ─────────────────────────────────────────────────────────────────────────────

# Operability knobs (H23.11). Defaults match serve.py; override in the env file.
# Loopback by default (local-first). A non-loopback JARVIS_HOST without a token
# is refused at boot unless JARVIS_ALLOW_INSECURE_BIND=1 — see serve.py.
Environment=JARVIS_HOST=127.0.0.1
Environment=JARVIS_PORT=8080
Environment=JARVIS_SHUTDOWN_TIMEOUT=10
Environment=JARVIS_LOG_LEVEL=info
# Keep runtime state out of the checkout (audit F-08). Point at a writable dir.
Environment=JARVIS_HOME=/var/lib/jarvis-hub
# Optional per-host overrides (tokens, secrets, JARVIS_WORLDVIEW=0, …). The
# leading '-' makes the file optional — the unit still starts if it's absent.
EnvironmentFile=-/etc/jarvis-hub/jarvis.env

# Restart policy — survive a crash, back off so a crash-loop doesn't thrash.
Restart=on-failure
RestartSec=5

# Graceful stop: SIGTERM → uvicorn drains in-flight requests (≤ shutdown timeout),
# then exits. Give it a margin over JARVIS_SHUTDOWN_TIMEOUT before SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=20

# ── Hardening (defense-in-depth; local-first, least privilege) ───────────────
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# strict ProtectSystem makes the FS read-only except these — the data root must
# be writable (SQLite DBs, logs, tokens). Add others if you relocate JARVIS_HOME.
ReadWritePaths=/var/lib/jarvis-hub

[Install]
WantedBy=multi-user.target

# Jarvis Hub — optional per-host environment for the systemd unit. (H23.15)
# Copy to /etc/jarvis-hub/jarvis.env and edit. Loaded via EnvironmentFile=- so
# it's optional. Values here override the Environment= lines in the unit.
#
# Anything serve.py / agents read from the environment is valid here. Common ones:

# Bind + operability (H23.11). Loopback is the safe default.
#JARVIS_HOST=127.0.0.1
#JARVIS_PORT=8080
#JARVIS_SHUTDOWN_TIMEOUT=10
#JARVIS_LOG_LEVEL=info

# Where runtime state lives (DBs, tokens, logs). Must be writable by User=.
#JARVIS_HOME=/var/lib/jarvis-hub

# H283: what the model should know about this machine that it cannot probe (a proxy,
# how credentials are handled, where shared drives are mounted). \n breaks a line.
# Given to every agent as a description, not as instructions; at most 2,000 chars.
#JARVIS_ENVIRONMENT_HINT=Headless NUC in the hall cupboard. Outbound HTTP goes through the proxy at 10.0.0.2:3128.\nThe NAS is mounted at /mnt/nas (read-only for the hub).

# Opt-in rotating file log (H23.11). Default is stderr only (journald captures it).
#JARVIS_LOG_FILE=/var/lib/jarvis-hub/logs/jarvis.log
#JARVIS_LOG_MAX_MB=10
#JARVIS_LOG_BACKUPS=5

# Only set if you deliberately bind off-loopback AND understand the exposure.
#JARVIS_ALLOW_INSECURE_BIND=0

# Skip the optional WorldView/Signal-Layer side services in this deployment.
#JARVIS_WORLDVIEW=0
#JARVIS_SIGNAL_LAYER=0

# Channel tokens / secrets (examples — leave unset to disable that channel).
#TELEGRAM_BOT_TOKEN=
#DISCORD_BOT_TOKEN=

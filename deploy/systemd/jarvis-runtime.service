# Jarvis Hub — headless runtime supervisor (coordinator + heartbeat + night
# shift), separate from the HTTP app (jarvis-hub.service).
#
# Install (edit the paths/User first — see deploy/systemd/README.md):
#   sudo cp deploy/systemd/jarvis-runtime.service /etc/systemd/system/
#   sudo cp deploy/systemd/jarvis-hub.env         /etc/jarvis-hub/jarvis.env   # optional overrides
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now jarvis-runtime
#   systemctl status jarvis-runtime   ·   journalctl -u jarvis-runtime -f
#
# ExecStart runs scripts/runtime_supervisor.py, which spawns
# scripts/coordinator.py and respawns it on any crash (including SIGKILL) —
# this unit's own Restart= is a second, OS-level layer of the same guarantee,
# not a substitute for it (the supervisor recovers a killed coordinator in
# well under a second; systemd recovers a killed supervisor).

[Unit]
Description=Jarvis Hub — runtime supervisor (coordinator/heartbeat/night-shift)
Documentation=https://github.com/andrei649/jarvis-hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ── EDIT THESE for your install ──────────────────────────────────────────────
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis-hub
ExecStart=/opt/jarvis-hub/.venv/bin/python scripts/runtime_supervisor.py
# ─────────────────────────────────────────────────────────────────────────────

Environment=JARVIS_HOME=/var/lib/jarvis-hub
Environment=JARVIS_RUNTIME_LOG=/var/lib/jarvis-hub/logs/runtime.jsonl
Environment=JARVIS_RUNTIME_STATE=/var/lib/jarvis-hub/logs/runtime_state.json
EnvironmentFile=-/etc/jarvis-hub/jarvis.env

# Restart policy — defense-in-depth over the in-process respawn loop.
Restart=on-failure
RestartSec=5

KillSignal=SIGTERM
TimeoutStopSec=20

# ── Hardening (defense-in-depth; local-first, least privilege) ───────────────
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/jarvis-hub

[Install]
WantedBy=multi-user.target

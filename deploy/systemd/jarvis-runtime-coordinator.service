# Jarvis Hub — Always-On autonomy runtime coordinator (headless, no HTTP).
#
# This is the production-grade alternative to `make runtime-up`
# (scripts/runtime_supervisor.py): systemd itself supplies the crash-recovery
# supervision (Restart=on-failure) instead of the portable Python wrapper, and
# the coordinator writes the same structured run-log at logs/runtime.jsonl
# (or $JARVIS_RUNTIME_LOG).
#
# Run this UNIT INSTEAD OF, never alongside, jarvis-hub.service against the same
# JARVIS_HOME: both independently start AutonomyCoordinator.loop() against the
# same durable autonomy.db, and running both would tick (and could double-execute
# approved tasks against) the same queue. Pick one deployment shape:
#   - jarvis-hub.service alone               → dashboard + engine in one process
#   - jarvis-runtime-coordinator.service      → headless engine only (this unit);
#     pair it with jarvis-hub.service on a DIFFERENT JARVIS_HOME if you also want
#     a dashboard, or front it with a separate read-only status page.
#
# Install (edit the paths/User first — mirrors deploy/systemd/README.md):
#   sudo cp deploy/systemd/jarvis-runtime-coordinator.service /etc/systemd/system/
#   sudo cp deploy/systemd/jarvis-hub.env /etc/jarvis-hub/jarvis.env   # optional overrides
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now jarvis-runtime-coordinator
#   systemctl status jarvis-runtime-coordinator   ·   journalctl -u jarvis-runtime-coordinator -f

[Unit]
Description=Jarvis Hub — Always-On autonomy runtime coordinator (headless)
Documentation=https://github.com/andrei649/jarvis-hub
After=network-online.target
Wants=network-online.target
Conflicts=jarvis-hub.service

[Service]
Type=simple
# ── EDIT THESE for your install ──────────────────────────────────────────────
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis-hub
ExecStart=/opt/jarvis-hub/.venv/bin/python -m agents.core.autonomy.runtime_coordinator
# ─────────────────────────────────────────────────────────────────────────────

Environment=JARVIS_LOG_LEVEL=info
# Keep runtime state out of the checkout (audit F-08). Point at a writable dir.
Environment=JARVIS_HOME=/var/lib/jarvis-hub
# Optional per-host overrides (tokens, secrets). Leading '-' makes it optional.
EnvironmentFile=-/etc/jarvis-hub/jarvis.env

# Restart policy — survive a crash (incl. a manual kill -9), back off so a
# crash-loop doesn't thrash.
Restart=always
RestartSec=5

KillSignal=SIGTERM
TimeoutStopSec=20

# ── Hardening (defense-in-depth; local-first, least privilege) ───────────────
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/jarvis-hub

[Install]
WantedBy=multi-user.target

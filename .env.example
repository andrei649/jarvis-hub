# Jarvis — Environment Variables
# Rename this file to .env and fill in your keys.
# !!! NEVER commit .env to git !!!

# ── Admin / Security ───────────────────────────────────────────
# Protects the /api/admin/* endpoints (settings, env, memory clear, agents).
# - Leave EMPTY: admin works only from localhost (safe for a local laptop).
# - Set a long random value: admin requires header  X-Admin-Token: <value>
#   REQUIRED before exposing the server on a LAN / Pi / public address.
JARVIS_ADMIN_TOKEN=

# Protects the user-facing routes (the assistant /chat, personal memory & notes,
# code execution) — one tier below admin (HF-1).
# - Leave EMPTY: these work only from localhost (safe for a local laptop).
# - Set a long random value: requires header  X-User-Token: <value>  (a valid
#   X-Admin-Token also works). REQUIRED before exposing /chat on a LAN / Pi /
#   public address. The HUD will prompt for it once and remember it.
JARVIS_USER_TOKEN=

# Fernet key that encrypts stored OAuth tokens at rest (Gmail/Calendar/Spotify).
# - Leave EMPTY: a key is generated on first use at data/tokens/.encryption_key
#   (perms 0600). Works, but the key lives on disk next to the ciphertext.
# - Set it (recommended): generate with
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   then store it in the secrets vault (H21.A) / this env so the key never
#   touches disk. Changing it makes existing tokens un-decryptable → re-authorize.
JARVIS_TOKEN_KEY=

# Per-IP HTTP rate limit (requests/minute) for unauthenticated network clients —
# DoS / token brute-force dampening (HF-2). Localhost and validly-authenticated
# requests are exempt. Default 120; set 0 to disable.
JARVIS_RATE_LIMIT=120

# CORS allow-list (HF-2). Empty = same-origin only (recommended). Set a comma-
# separated list of origins to allow cross-origin reads, e.g. a widget host:
#   JARVIS_CORS_ORIGINS=https://blog.example,https://shop.example
JARVIS_CORS_ORIGINS=

# Skills supply chain (H12.12, anti-ClawHub). Installs are always zip-slip-safe;
# these add opt-in enforcement on top of the metadata the HUD already surfaces:
# - JARVIS_REQUIRE_REVIEWED_SKILLS=1 → only marketplace skills moderated to
#   'approved' may be installed (publish → pending → you approve).
# - JARVIS_REQUIRE_SIGNED_SKILLS=1 → refuse installing/loading an unsigned or
#   tampered skill package.
# - JARVIS_SKILL_SIGNING_KEY=<secret> → HMAC-key the signatures (else a plain
#   content hash). Keep it off the published machine.
JARVIS_REQUIRE_REVIEWED_SKILLS=
JARVIS_REQUIRE_SIGNED_SKILLS=
JARVIS_SKILL_SIGNING_KEY=

# Agent-to-Agent (A2A, H16.2). A network surface — OFF unless enabled. Peers are
# allowlisted with a shared secret and sign every request; inbound tasks land in
# an approval inbox and never auto-execute.
# - JARVIS_A2A_ENABLED=1 → expose /.well-known/agent-card and POST /api/a2a/task.
# - JARVIS_A2A_KEY=<secret> → HMAC-sign our advertised Agent Card (else advisory).
JARVIS_A2A_ENABLED=
JARVIS_A2A_KEY=

# ── Dev agent / Superpowers privacy opt-outs ─────────────────────
# These are for local coding-agent harnesses (Claude Code, Codex/OpenCode, etc.),
# not Jarvis runtime behavior. Keep them true by default on privacy-sensitive
# machines when using external agent methodology plugins.
SUPERPOWERS_DISABLE_TELEMETRY=true
DISABLE_TELEMETRY=true
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=true

# ── LLM ────────────────────────────────────────────────────────
# Tiered routing (S0.1): heavy agents (Vision, Steve) → Claude API, light agents → local 7B
# Claude API for heavy reasoning agents (0 VRAM), falls back to Gemini/cloud if missing
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Gemini API key for hybrid router (context >8K -> Gemini Flash, >128K -> Gemini Pro)
GEMINI_API_KEY=

# ── Telegram ────────────────────────────────────────────────────
# Bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# ── Google APIs ─────────────────────────────────────────────────
# OAuth 2.0 credentials (create project at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth 2.0 access tokens for Google services (auto-refreshed if GOOGLE_CLIENT_* are set)
GMAIL_ACCESS_TOKEN=
GOOGLE_CALENDAR_TOKEN=

# ── Spotify ─────────────────────────────────────────────────────
# Spotify Developer app credentials + OAuth tokens
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_ACCESS_TOKEN=
SPOTIFY_REFRESH_TOKEN=

# ── Discord ───────────────────────────────────────────────────
# Bot token from Discord Developer Portal
DISCORD_BOT_TOKEN=

# ── SMTP/IMAP (Email Channel) ──────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# ── Slack ──────────────────────────────────────────────────────
SLACK_BOT_TOKEN=

# ── Knowledge Graph (Neo4j — optional) ──────────────────────────
# Set KNOWLEDGE_GRAPH_BACKEND=neo4j to use Neo4j, or "memory" for in-memory fallback.
KNOWLEDGE_GRAPH_BACKEND=memory
NEO4J_URL=http://localhost:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

# ── Qdrant Vector Database (optional) ────────────────────────────
# Set to "qdrant" to use Qdrant instead of in-memory vector store
VECTOR_BACKEND=memory
QDRANT_URL=http://localhost:6333

# ── Recall Embeddings (long-term memory) ─────────────────────────
# Engine that turns text into vectors for fused recall (vector ⊕ graph).
#   EMBED_BACKEND=lmstudio  → LM Studio /v1/embeddings (default, on the 1234 port)
#   EMBED_BACKEND=ollama    → dedicated Ollama embedding model
# Either degrades to a deterministic hash embedding if unreachable, so recall
# never hard-fails. Keep EMBED_MODEL's output dimension at 768 (store default).
#
# H8.4 — Recommended quality model: mxbai-embed-large
#   Load "mxbai-embed-large" in LM Studio (Models tab) for best retrieval quality.
#   It uses the same /v1/embeddings interface as the default nomic model.
#   Alternatively set EMBED_BACKEND=ollama to pull it via: ollama pull mxbai-embed-large
EMBED_BACKEND=lmstudio
# Recommended quality model (H8.4): mxbai-embed-large loaded in LM Studio
EMBED_MODEL=mxbai-embed-large
EMBED_BASE_URL=http://localhost:1234
# Set to true to auto-embed every conversation turn into long-term memory.
MEMORY_EMBED_TURNS=false
# Disk cache for recall query-embeddings (H7.4); identical queries skip the
# network round-trip. Default: memory_logs/embedding_cache/recall.
EMBED_CACHE_DIR=

# ── LLM Model Tiering (fast vs heavy) ────────────────────────────
# H7.5: complexity-based escalation — light requests use the fast VRAM model,
# heavy ones (long context or reasoning cues) use the deep slot (DDR5 spillover).
# Set JARVIS_AUTO_DEEP=0 to disable escalation; JARVIS_DEEP_MODEL overrides the
# deep-slot model name (loaded by LM Studio in slot 2).
JARVIS_AUTO_DEEP=1
JARVIS_DEEP_MODEL=deepseek-r1-distill-qwen-32b

# ── LM Studio lifecycle control (start / load / unload) ──────────
# Lets Jarvis START the LM Studio server and LOAD/UNLOAD models — via the `lms`
# CLI (argv, no shell) — from the admin UI and from chat ("load gemma", "start
# LM Studio"). KILL-SWITCH: set to 0/false to make all mutating control a no-op
# (status/read still works); also flippable live in admin Settings as
# `llm.control_enabled` (no restart). Leave on for normal use.
JARVIS_LMSTUDIO_CONTROL=1
# Narrower switch: mute only the *natural-language* chat detection (so a stray
# "load up the data" can never act) while keeping the explicit admin buttons.
# Live setting: `llm.chat_control`.
JARVIS_LMSTUDIO_CHAT_CONTROL=1

# ── Oracle GitHub watcher (dev/dogfooding — OFF by default) ──────
# The Oracle bridge can poll a GitHub repo every 30s to auto-pull + test commits
# from parallel agent sessions. OFF by default — a privacy-first local app should
# not make unsolicited outbound calls. Set to 1 to enable on a dev box; also
# flippable live as the `oracle.watch_enabled` setting.
JARVIS_ORACLE_WATCH=0

# ── LAN Bridges ─────────────────────────────────────────────────
# URLs for local bridge services on your network
WHATSAPP_BRIDGE_URL=http://192.168.1.100:3000
APPLE_HEALTH_BRIDGE_URL=http://192.168.1.100:8081
HOMEBRIDGE_URL=http://192.168.1.100:8581
HOMEBRIDGE_TOKEN=

# ── Personal Drive import (PRIVATE personalization — rclone) ─────
# Fast-import an owner-configured Google Drive folder (e.g. the root "AI" folder)
# into a GITIGNORED local dir, then ingest it into memory (local-docs indexer).
# Privacy: the Drive OAuth lives in your own rclone.conf (run `rclone config`),
# the synced content lands under memory_logs/ (gitignored), and only the remote
# NAME + dest are read here — no secrets in this file, nothing committed.
# Setup: 1) rclone config  → make a Drive remote (e.g. "gdrive")
#        2) set JARVIS_DRIVE_AI_REMOTE below  3) JARVIS_DRIVE_AI_SYNC=1 (or run
#           scripts/import_drive_ai.py during onboarding).
JARVIS_DRIVE_AI_REMOTE=                 # e.g. gdrive:AI  (remote:folder) — empty = off
JARVIS_DRIVE_AI_SYNC=0                  # 1 = sync at startup (fire-and-forget)
JARVIS_DRIVE_AI_INDEX=1                 # 1 = also ingest into memory after sync (0 = sync only)
JARVIS_DRIVE_AI_MODE=copy              # copy (non-destructive) | sync (mirror)
JARVIS_DRIVE_AI_DEST=                   # override local dest (default: memory_logs/drive_ai)
JARVIS_DRIVE_AI_FLAGS=                  # extra rclone flags, space-separated

# ── Governance & hardening (all default OFF; ADV-117) ────────────
# The adversarial audit (2026-07-25) found none of these here, which is a large part of
# why "is the kernel on?" kept being answered from memory rather than from a file. The
# defaults below are the shipped defaults — copying this file changes nothing.
#
# Worth stating because the audit's loudest first-pass claim got it backwards: the Action
# Kernel is an *additional deny layer*, not the only one. With it off, the payment
# contract, the approval queue and the audit log all still run — an over-cap payment is
# still refused. Turning it ON unlocks autonomy rather than adding safety.
JARVIS_ACTION_KERNEL=0                  # 1 = mediate privileged actions through kernel.authorize
JARVIS_UNIFIED_ACTION_API=0             # 1 = enable the H27 capability action plane
JARVIS_HARDENED=0                       # 1 = design-partner/hardened preset (see below)

# Required by JARVIS_HARDENED=1: the audit chain is HMAC-keyed with it, so an attacker
# with DB write access cannot forge the chain. WITHOUT a key the chain is integrity-only,
# not tamper-evident — GET /api/security/audit/verify reports the difference.
# Keep this OFF-BOX (a password manager, not this repo, not the data root).
JARVIS_AUDIT_KEY=

# Skill signing. Enforcement REQUIRES a key: without one the "signature" is a plain sha256
# an attacker can recompute and ship in their own SKILL.sig, so the gate would stop honest
# unsigned skills and not a deliberate one. Setting the flag with no key fails closed.
JARVIS_REQUIRE_SIGNED_SKILLS=0
JARVIS_SKILL_SIGNING_KEY=

# Encrypts backups AND the pre-forget archive. If unset, one is generated under
# $JARVIS_KEY_DIR (default ~/.config/jarvis) — outside the data root, so a stolen archive
# never ships its own key.
JARVIS_BACKUP_KEY=
JARVIS_KEY_DIR=

# 'Forget me' archives (POST /api/admin/forget). The archive is a complete copy of
# everything you asked to delete, so it is encrypted, kept outside the data root, and
# pruned. Default keeps only the newest.
JARVIS_FORGET_ARCHIVE_DIR=              # default: a sibling of the data root
JARVIS_FORGET_ARCHIVE_KEEP=1            # 0 = keep none

# Telegram owner allowlist (comma-separated user ids). Empty is valid — sender pairing is
# the primary gate — but the approval-callback owner check needs either this or
# autonomy.owner_chat_id, and fails closed with neither.
TELEGRAM_ALLOWED_USER_IDS=

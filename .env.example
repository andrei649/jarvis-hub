# JARVIS HUB — Environment
# Copy this to .env and fill in your keys

# Ollama (local, no key needed)
OLLAMA_HOST=http://localhost:11434

# Telegram Bot (optional — for Telegram channel)
TELEGRAM_BOT_TOKEN=

# Gmail API (optional — for email triage)
GMAIL_CREDENTIALS_PATH=

# Google Calendar (optional)
CALENDAR_CREDENTIALS_PATH=

# Slack (optional)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# WhatsApp (optional — Frigga only)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Spotify (optional — Jerome)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Homebridge (optional)
HOMEBRIDGE_URL=http://localhost:8581
HOMEBRIDGE_PIN=

# Claude API (optional — replaces Ollama for LLM)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# Nerva — Environment Variables
# Rename this file to .env and fill in your keys.
# !!! NEVER commit .env to git !!!
#
# Spelling: every hub variable is NERVA_<X>. The older spelling JARVIS_<X> is the same
# variable and still works (deprecated): an existing .env needs no change. Use one
# spelling per variable — if this file, or the process environment, sets both to
# different values the hub refuses to start and names the variable. `nerva doctor` shows
# which lines still use the old spelling.
#
# Pinned by the launcher: Docker (Dockerfile, docker-compose*.yml), the systemd units and
# the Windows service script set a few variables themselves, under the JARVIS_ spelling:
# JARVIS_HOST, JARVIS_PORT, JARVIS_HOME, and for the services JARVIS_SHUTDOWN_TIMEOUT,
# JARVIS_RUNTIME_LOG, JARVIS_RUNTIME_STATE. If you run under one of those, do NOT set
# NERVA_HOST / NERVA_PORT / NERVA_HOME … here (compose passes this file into the same
# environment: one variable set twice, a refused start). To change a pinned variable:
# under compose, edit the line in the compose file (a line here does not override it);
# under systemd, use a JARVIS_<X> line in the unit's env file. Details: docs/FLAGS.md.
#
# References: ${NAME} and ${NAME:-default} work, under either spelling of a hub variable,
# and are expanded in every value, quoted or not. A path or a credential built from a
# ${NAME} that nothing sets is refused at start (the path would silently lose that part,
# the credential would silently be shortened); anything else boots with a warning.

# ── Admin / Security ───────────────────────────────────────────
# Protects the /api/admin/* endpoints (settings, env, memory clear, agents).
# - Leave EMPTY: admin works only from localhost (safe for a local laptop).
# - Set a long random value: admin requires header  X-Admin-Token: <value>
#   REQUIRED before exposing the server on a LAN / Pi / public address.
NERVA_ADMIN_TOKEN=

# Protects the user-facing routes (the assistant /chat, personal memory & notes,
# code execution) — one tier below admin (HF-1).
# - Leave EMPTY: these work only from localhost (safe for a local laptop).
# - Set a long random value: requires header  X-User-Token: <value>  (a valid
#   X-Admin-Token also works). REQUIRED before exposing /chat on a LAN / Pi /
#   public address. The HUD will prompt for it once and remember it.
NERVA_USER_TOKEN=

# Reverse proxies whose X-Forwarded-For may be believed (comma-separated: 127.0.0.1/32 for
# a same-box Caddy). An entry is the proxy's OWN address, never a range that also contains
# clients (a client inside a listed range could name any client). Unset: forwarding headers
# are ignored and a request carrying them fails the localhost gate closed. "*" or /0 refuse
# to boot. (NERVA_TRUSTED_PROXY=1 is deprecated and now means loopback only.)
NERVA_TRUSTED_PROXIES=
# Extra Host names accepted besides loopback names, IP literals and the bind address
# (a Tailscale or Caddy name). Any other Host answers 400 — the DNS-rebinding defence.
NERVA_ALLOWED_HOSTS=

# Fernet key that encrypts stored OAuth tokens at rest (Gmail/Calendar/Spotify).
# - Leave EMPTY: a key is generated on first use at data/tokens/.encryption_key
#   (perms 0600). Works, but the key lives on disk next to the ciphertext.
# - Set it (recommended): generate with
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   then store it in the secrets vault (H21.A) / this env so the key never
#   touches disk. Changing it makes existing tokens un-decryptable → re-authorize.
NERVA_TOKEN_KEY=

# Per-IP HTTP rate limit (requests/minute) for unauthenticated network clients —
# DoS / token brute-force dampening (HF-2). Localhost and validly-authenticated
# requests are exempt. Default 120; set 0 to disable.
NERVA_RATE_LIMIT=120

# CORS allow-list (HF-2). Empty = same-origin only (recommended). Set a comma-
# separated list of origins to allow cross-origin reads, e.g. a widget host:
#   NERVA_CORS_ORIGINS=https://blog.example,https://shop.example
NERVA_CORS_ORIGINS=

# Skills supply chain (H12.12, anti-ClawHub). Installs are always zip-slip-safe;
# these add opt-in enforcement on top of the metadata the HUD already surfaces:
# - NERVA_REQUIRE_REVIEWED_SKILLS=1 → only marketplace skills moderated to
#   'approved' may be installed (publish → pending → you approve).
# - NERVA_REQUIRE_SIGNED_SKILLS=1 → refuse installing/loading an unsigned or
#   tampered skill package.
# - NERVA_SKILL_SIGNING_KEY=<secret> → HMAC-key the signatures (else a plain
#   content hash). Keep it off the published machine.
NERVA_REQUIRE_REVIEWED_SKILLS=
NERVA_REQUIRE_SIGNED_SKILLS=
NERVA_SKILL_SIGNING_KEY=

# Agent-to-Agent (A2A, H16.2). A network surface — OFF unless enabled. Peers are
# allowlisted with a shared secret and sign every request; inbound tasks land in
# an approval inbox and never auto-execute.
# - NERVA_A2A_ENABLED=1 → expose /.well-known/agent-card and POST /api/a2a/task.
# - NERVA_A2A_KEY=<secret> → HMAC-sign our advertised Agent Card (else advisory).
NERVA_A2A_ENABLED=
NERVA_A2A_KEY=

# ── Dev agent / Superpowers privacy opt-outs ─────────────────────
# These are for local coding-agent harnesses (Claude Code, Codex/OpenCode, etc.),
# not Jarvis runtime behavior. Keep them true by default on privacy-sensitive
# machines when using external agent methodology plugins.
SUPERPOWERS_DISABLE_TELEMETRY=true
DISABLE_TELEMETRY=true
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=true

# ── LLM ────────────────────────────────────────────────────────
# Tiered routing (S0.1): heavy agents (Vision, Steve) → Claude API, light agents → local 7B
# Claude API for heavy reasoning agents (0 VRAM), falls back to Gemini/cloud if missing
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Gemini API key for hybrid router (context >8K -> Gemini Flash, >128K -> Gemini Pro)
GEMINI_API_KEY=

# ── Telegram ────────────────────────────────────────────────────
# Bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# ── ntfy (push to your phone, no bot, no account) ───────────────
# By default Nerva only POSTs to NTFY_URL/NTFY_TOPIC (escalations, job deliveries with
# channel "ntfy"). No default server — name your own (self-hosted keeps it on the LAN) or
# https://ntfy.sh. The topic is the identity: treat it like a password. NTFY_TOKEN is the
# Bearer token (or user:password for Basic); NTFY_TITLE the notification title.
# Receiving requires NTFY_INBOUND=1 and the shared sender-pairing gate. Approve the
# topic in the pairing inbox; every publisher with access to that topic shares its
# identity. Received turns are untrusted and replies enter channel.reply approval.
# Server/config changes require an adapter restart; old queued replies are refused.
# NTFY_SERVER_URL is accepted as a Hermes alias when NTFY_URL is unset.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
NTFY_TITLE=Nerva
NTFY_INBOUND=0
NTFY_PUBLISH_TOPIC=
NTFY_MARKDOWN=0

# ── TLS trust (only needed behind a proxy that inspects HTTPS) ──────────────────
# A PEM of extra CA roots for plugin and model egress. Without it, behind a corporate MITM
# or an inspecting VPN, every outbound call fails and web_search answers "0 results" instead
# of saying why. It only ADDS trust. A CA variable that is set but broken (this one,
# SSL_CERT_FILE, REQUESTS_CA_BUNDLE, CURL_CA_BUNDLE, SSL_CERT_DIR) stops the start with its fix.
NERVA_CA_BUNDLE=
# Model provider ids or hosts (comma-separated) whose clients skip certificate checking —
# only for a LAN model server on a self-signed certificate. Each such client logs a WARNING;
# NERVA_HARDENED=1 ignores the list. Prefer adding the server's certificate above.
NERVA_TLS_INSECURE_TARGETS=

# ── Web search (the model's web_search / web_extract tools, and research tasks) ──
# Nothing is required: with both empty the search falls back to DuckDuckGo's HTML endpoint,
# which needs the optional `beautifulsoup4` package (requirements-beta.txt) — without it the
# tool answers websearch_unavailable, never a fake "nothing found". A Tavily key or a SearXNG
# instance (self-hosted keeps queries on the LAN) replaces the fallback.
TAVILY_API_KEY=
SEARXNG_URL=

# ── Google APIs ─────────────────────────────────────────────────
# OAuth 2.0 credentials (create project at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth 2.0 access tokens for Google services (auto-refreshed if GOOGLE_CLIENT_* are set)
GMAIL_ACCESS_TOKEN=
GOOGLE_CALENDAR_TOKEN=

# ── Spotify ─────────────────────────────────────────────────────
# Spotify Developer app credentials + OAuth tokens
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_ACCESS_TOKEN=
SPOTIFY_REFRESH_TOKEN=

# ── Discord ───────────────────────────────────────────────────
# Bot token from Discord Developer Portal
DISCORD_BOT_TOKEN=

# ── SMTP/IMAP (Email Channel) ──────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# ── Slack ──────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
# Optional live inbox: enable Socket Mode and provide an app-level token with
# connections:write. Without this, only host-supplied Slack events are received.
# Setup, event subscriptions and pairing: docs/SLACK_SETUP.md
SLACK_APP_TOKEN=

# ── Knowledge Graph (Neo4j — optional) ──────────────────────────
# Set KNOWLEDGE_GRAPH_BACKEND=neo4j to use Neo4j, or "memory" for in-memory fallback.
KNOWLEDGE_GRAPH_BACKEND=memory
NEO4J_URL=http://localhost:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

# ── Qdrant Vector Database (optional) ────────────────────────────
# Set to "qdrant" to use Qdrant instead of in-memory vector store
VECTOR_BACKEND=memory
QDRANT_URL=http://localhost:6333

# ── Recall Embeddings (long-term memory) ─────────────────────────
# Engine that turns text into vectors for fused recall (vector ⊕ graph).
#   EMBED_BACKEND=lmstudio  → LM Studio /v1/embeddings (default, on the 1234 port)
#   EMBED_BACKEND=ollama    → dedicated Ollama embedding model
# Either degrades to a deterministic hash embedding if unreachable, so recall
# never hard-fails. Keep EMBED_MODEL's output dimension at 768 (store default).
#
# H8.4 — Recommended quality model: mxbai-embed-large
#   Load "mxbai-embed-large" in LM Studio (Models tab) for best retrieval quality.
#   It uses the same /v1/embeddings interface as the default nomic model.
#   Alternatively set EMBED_BACKEND=ollama to pull it via: ollama pull mxbai-embed-large
EMBED_BACKEND=lmstudio
# Recommended quality model (H8.4): mxbai-embed-large loaded in LM Studio
EMBED_MODEL=mxbai-embed-large
EMBED_BASE_URL=http://localhost:1234
# Set to true to auto-embed every conversation turn into long-term memory.
MEMORY_EMBED_TURNS=false
# Disk cache for recall query-embeddings (H7.4); identical queries skip the
# network round-trip. Default: memory_logs/embedding_cache/recall.
EMBED_CACHE_DIR=

# ── LLM Model Tiering (fast vs heavy) ────────────────────────────
# H7.5: complexity-based escalation — light requests use the fast VRAM model,
# heavy ones (long context or reasoning cues) use the deep slot (DDR5 spillover).
# Set NERVA_AUTO_DEEP=0 to disable escalation; NERVA_DEEP_MODEL overrides the
# deep-slot model name (loaded by LM Studio in slot 2).
NERVA_AUTO_DEEP=1
NERVA_DEEP_MODEL=deepseek-r1-distill-qwen-32b

# ── Vision (VLM) ─ default OFF ─────────────────────────────────────────────
# LM Studio (load a vlm-type model; serves on 1234/v1), vLLM and llama.cpp all
# speak the same OpenAI-vision contract. Unset = /api/vlm/* reports honestly
# "not configured" — nothing is guessed.
#   NERVA_VLM_BACKEND=lmstudio + NERVA_VLM_MODEL=<loaded model id>
#     → uses http://localhost:1234/v1 (override with NERVA_VLM_URL)
#   NERVA_VLM_BACKEND=custom + NERVA_VLM_URL=http://localhost:8001/v1
#     → vLLM / llama.cpp; NERVA_VLM_MODEL optional (defaults qwen2-vl)
#NERVA_VLM_BACKEND=
#NERVA_VLM_URL=
#NERVA_VLM_MODEL=
#NERVA_VLM_KEY=

# Nous account authentication. Login alone does not select a vision provider or model.
# Set a registered public OAuth client ID; no Nerva client registration is assumed.
# Owner flow: nerva auth nous login --profile default (admin token required).
#NERVA_NOUS_CLIENT_ID=
#NERVA_NOUS_PORTAL_URL=https://portal.nousresearch.com
# The account owns its inference endpoint; this is an explicit account override.
#NERVA_NOUS_INFERENCE_BASE_URL=
# Anthropic catalog models use chat/completions by default. Only native switches
# anthropic/* to Messages; auto currently stays on chat, as do invalid values.
#NERVA_NOUS_ANTHROPIC_WIRE=chat

# ── Model roles (H277) ─ separate models for separate jobs ─────────
# The NERVA_ROLE_* names win when set; NERVA_VLM_* / NERVA_DEEP_MODEL above stay
# the fallbacks. Providers are ProviderProfile ids (docs/FLAGS.md has the table).
#   vision: lm-studio | openai-compatible | openrouter | deepinfra | nous | auto
#           (NERVA_VLM_KEY as before for local/custom; a changed local/custom
#           role base gets only NERVA_ROLE_VISION_KEY)
#   deep:   model only (served by the local backend)
#   video:  opt-in video_analyze tool; lm-studio | openai-compatible | gemini
#NERVA_ROLE_VISION_PROVIDER=
# For provider=nous, use a logged-in account profile (default: default).
#NERVA_ROLE_VISION_PROFILE=default
#NERVA_ROLE_VISION_MODEL=
#NERVA_ROLE_VISION_BASE_URL=
#NERVA_ROLE_VISION_KEY=
# Auto is opt-in: the image composer tries OpenRouter's dedicated :free vision
# model, then a logged-in Nous account, then DeepInfra's served vision catalog.
# It has no selected main conversation route today, so that candidate is absent.
# An explicit role base is authoritative and requires a role model plus a key
# scoped to that endpoint. Image POST never performs discovery or account refresh.
# Nous uses its account token and inference endpoint. A role base must exactly
# match that endpoint; a nonempty role key is refused. Explicit role model wins;
# otherwise composer status prepares a Portal recommendation. Refresh vision
# destination refreshes the public catalog without forcing OAuth token rotation.
# Image POSTs and role/policy reads only use the prepared local selection.
# OpenRouter vision requires an explicit role model and OPENROUTER_API_KEY on
# https://openrouter.ai/api/v1, or a dedicated role key for another role base.
# Legacy VLM settings/keys and OPENROUTER_BASE_URL are ignored for this provider.
# Its live llm.openrouter_* privacy/routing rules remain mandatory. No auto discovery.
# DeepInfra vision uses an explicit role model or the first served chat/vision
# model from its credential-scoped catalog. Composer status may fetch metadata;
# it never sends images. Refresh vision destination refreshes that catalog.
# Ambient DEEPINFRA_API_KEY is scoped to https://api.deepinfra.com (HTTPS/443);
# a custom DEEPINFRA_BASE_URL or role base needs NERVA_ROLE_VISION_KEY.
#DEEPINFRA_API_KEY=
#DEEPINFRA_BASE_URL=
# One extra same-model call after a structurally valid empty image response.
# Governed composer/describe/screen/media/camera scopes only; changes invalidate
# prior composer destination confirmations and unattended role grants.
NERVA_ROLE_VISION_EMPTY_RETRIES=0
#NERVA_ROLE_DEEP_MODEL=
# Optional independent models on the existing local backend (H277).
# Blank preserves the active local model and each task's existing fallback.
# These model IDs do not select providers or activate the auxiliary features.
#NERVA_AUX_SESSION_TITLE_MODEL=
#NERVA_AUX_QUERY_REWRITE_MODEL=
#NERVA_AUX_REVIEW_MODEL=
#NERVA_AUX_COMPRESSION_MODEL=
#NERVA_AUX_ONESHOT_MODEL=
# Acquisition captures its model once for both JSON attempts.
#NERVA_AUX_ACQUISITION_CAPABILITY_MODEL=
#NERVA_AUX_ACQUISITION_DRAFT_MODEL=
#NERVA_ROLE_VIDEO_PROVIDER=
#NERVA_ROLE_VIDEO_MODEL=
#NERVA_ROLE_VIDEO_BASE_URL=
#NERVA_ROLE_VIDEO_KEY=
# Without VIDEO_PROVIDER/BASE_URL, a valid vision route supplies the endpoint;
# VIDEO_MODEL overrides its model (blank/auto inherits the resolved vision model).
# An explicit video route needs its own model. VIDEO_KEY wins; otherwise only the
# effective vision key for the exact same provider/native request URL is inherited.
# Gemini uses only VIDEO_KEY; never GEMINI_API_KEY or a vision key. Its default base
# is https://generativelanguage.googleapis.com/v1beta; a custom native base is explicit.
# Optional ordered fallbacks: at most four exact provider/model/base_url records.
# Native lm-studio, openai-compatible and gemini adapters; no credential discovery.
#NERVA_ROLE_VIDEO_FALLBACKS=[{"provider":"lm-studio","model":"backup-video","base_url":"http://127.0.0.1:1235/v1"}]
#NERVA_ROLE_VIDEO_FALLBACK_1_KEY=
#NERVA_ROLE_VIDEO_FALLBACK_2_KEY=
#NERVA_ROLE_VIDEO_FALLBACK_3_KEY=
#NERVA_ROLE_VIDEO_FALLBACK_4_KEY=
# Each fallback has separate Security Posture consent; the approval binds the ordered
# full chain. Invalid unused candidates refuse intake. Empty keys support local/custom
# keyless servers; no primary/vision/main key is borrowed by a fallback.
# Optional primary-only recovery: 0 (default) or 1 transient retry after a typed
# connection failure or HTTP 408/5xx within each consumer call. Ordinary timeouts
# and fallback routes have no transient retry. Changes stale pending approvals.
NERVA_ROLE_VIDEO_TRANSIENT_RETRIES=0
# Optional consumer recovery: a structurally valid empty result restarts the whole
# approved chain once. Reuses prepared video and the total execution deadline;
# each call retains its primary transient budget. Changes stale pending approvals.
NERVA_ROLE_VIDEO_EMPTY_RETRIES=0
# Video understanding is separate from video generation and inbound attachments.
# Gemini uses inline_data with the declared container MIME; Matroska is refused.
# Its serialized request must be below 20,000,000 bytes, including prompt/base64.
# Local files must be inside NERVA_FILE_ROOTS. Each execution needs owner approval
# and signed task mediation (NERVA_TASK_MEDIATION=enforce); other modes refuse video.
# Remote models additionally need role opt-in, per-call allow_remote and the
# independent Video analysis consent in Security Posture. Defaults stay off.
NERVA_VIDEO_ANALYSIS=0
NERVA_ROLE_VIDEO_ALLOW_REMOTE=0
# Approval judge — default OFF. Set a model to have each queued tool-call approval
# scored (risk 0-100 + one line) as an ADVISORY opinion on the card; it never
# approves or blocks. "active" reuses the model already loaded (no second model).
# The call's tool/agent/summary/arguments are sent to the judge: a local judge
# (lm-studio/ollama on loopback) keeps them on this machine; anything else needs
# NERVA_ROLE_APPROVAL_JUDGE_ALLOW_REMOTE=1 and is off under strict-local,
# llm.cloud_fallback=never and safe mode.
# NERVA_ROLE_APPROVAL_JUDGE_KEY is the only key a judge address ever receives
# (lm-studio/ollama get none without it; openai-compatible gets OPENAI_API_KEY only on
# OPENAI_BASE_URL's own scheme/host/port).
# Timeout (seconds): a value below 1 s or unparsable falls back to 20 s; a value
# above 60 s is 60 s.
#NERVA_ROLE_APPROVAL_JUDGE_PROVIDER=lm-studio
#NERVA_ROLE_APPROVAL_JUDGE_MODEL=active
#NERVA_ROLE_APPROVAL_JUDGE_BASE_URL=
#NERVA_ROLE_APPROVAL_JUDGE_ALLOW_REMOTE=0
#NERVA_ROLE_APPROVAL_JUDGE_KEY=
#NERVA_ROLE_APPROVAL_JUDGE_TIMEOUT=20

# Optional smart guardian for terminal_run tasks only (default OFF). Requires
# the dedicated approval judge above and the existing signed task authority.
# APPROVE permits one exact operation; DENY/ESCALATE keep the owner decision card.
# Remote use still needs the judge's independent consent; this flag grants none.
# Operator rules are trusted configuration, never supplied by a task or model.
# Explicit deny globs are a terminal floor even when smart mode is off; malformed
# configured rules refuse execution. Existing hardline/kernel/target rules remain.
#NERVA_SMART_APPROVALS=0
#NERVA_SMART_APPROVAL_POLICY=
#NERVA_SMART_APPROVAL_DENY='["git push*", "curl*|*sh*"]'
# Next authenticated owner turn warns after this many consecutive committed DENYs.
# <=0 disables the warning; default 3. This feedback grants no execution authority.
#NERVA_SMART_DENIAL_BREAKER_THRESHOLD=3

# ── Local-model lifecycle control (LM Studio + Ollama) ───────────
# Lets Jarvis START and LOAD/UNLOAD local models. LM Studio uses `lms`; Ollama
# uses fixed `ollama serve` argv plus its localhost API (never a shell). Chat/MCP
# mutation additionally requires NERVA_ACTION_KERNEL=1 below, an explicit GRANT,
# system-control permission and durable audit preflight. KILL-SWITCH: set this
# legacy-named master to 0/false to make all mutating control a no-op
# (status/read still works); also flippable live in admin Settings as
# `llm.control_enabled` (no restart). Leave on for normal use.
NERVA_LMSTUDIO_CONTROL=1
# Narrower switch: mute only the *natural-language* chat detection (so a stray
# "load up the data" can never act) while keeping the explicit admin buttons.
# Live setting: `llm.chat_control`.
NERVA_LMSTUDIO_CHAT_CONTROL=1

# ── Oracle GitHub watcher (dev/dogfooding — OFF by default) ──────
# The Oracle bridge can poll a GitHub repo every 30s to auto-pull + test commits
# from parallel agent sessions. OFF by default — a privacy-first local app should
# not make unsolicited outbound calls. Set to 1 to enable on a dev box; also
# flippable live as the `oracle.watch_enabled` setting.
NERVA_ORACLE_WATCH=0

# ── LAN Bridges ─────────────────────────────────────────────────
# URLs for local bridge services on your network
WHATSAPP_BRIDGE_URL=http://192.168.1.100:3000
APPLE_HEALTH_BRIDGE_URL=http://192.168.1.100:8081
HOMEBRIDGE_URL=http://192.168.1.100:8581
HOMEBRIDGE_TOKEN=

# ── Personal Drive import (PRIVATE personalization — rclone) ─────
# Fast-import an owner-configured Google Drive folder (e.g. the root "AI" folder)
# into a GITIGNORED local dir, then ingest it into memory (local-docs indexer).
# Privacy: the Drive OAuth lives in your own rclone.conf (run `rclone config`),
# the synced content lands under memory_logs/ (gitignored), and only the remote
# NAME + dest are read here — no secrets in this file, nothing committed.
# Setup: 1) rclone config  → make a Drive remote (e.g. "gdrive")
#        2) set NERVA_DRIVE_AI_REMOTE below  3) NERVA_DRIVE_AI_SYNC=1 (or run
#           scripts/import_drive_ai.py during onboarding).
# e.g. gdrive:AI  (remote:folder) — empty = off
NERVA_DRIVE_AI_REMOTE=
NERVA_DRIVE_AI_SYNC=0                  # 1 = sync at startup (fire-and-forget)
NERVA_DRIVE_AI_INDEX=1                 # 1 = also ingest into memory after sync (0 = sync only)
NERVA_DRIVE_AI_MODE=copy              # copy (non-destructive) | sync (mirror)
# override local dest (default: memory_logs/drive_ai)
NERVA_DRIVE_AI_DEST=
# extra rclone flags, space-separated
NERVA_DRIVE_AI_FLAGS=

# ── Governance & hardening (all default OFF; ADV-117) ────────────
# The adversarial audit (2026-07-25) found none of these here, which is a large part of
# why "is the kernel on?" kept being answered from memory rather than from a file. The
# defaults below are the shipped defaults — copying this file changes nothing.
#
# Worth stating because the audit's loudest first-pass claim got it backwards: the Action
# Kernel is an *additional deny layer*, not the only one. With it off, the payment
# contract, the approval queue and the audit log all still run — an over-cap payment is
# still refused. Turning it ON unlocks autonomy rather than adding safety.
NERVA_ACTION_KERNEL=0                  # set 1 for owner-authorized LM Studio/Ollama lifecycle autonomy
# Optional pinned Hermes runtime; provision with python scripts/hermes_runtime.py install.
# Admin runtime control additionally requires the enabled/bound Action Kernel.
NERVA_HERMES_ENABLED=0
# Governed Hermes approval dispatch also needs NERVA_ACTION_KERNEL=1,
# NERVA_TASK_MEDIATION=enforce, global autonomy AUTO and the signed persistent
# IntentLog/TaskQueue. See docs/hermes/OPERATOR.md. Keep provider credentials in
# the private Hermes profile; the Hub does not import an existing profile.
NERVA_UNIFIED_ACTION_API=0             # 1 = enable the H27 capability action plane
NERVA_HARDENED=0                       # 1 = design-partner/hardened preset (see below)
# H182: hold a power assertion (caffeinate / systemd-inhibit / SetThreadExecutionState)
# while a turn runs, so the machine does not idle-sleep mid-reply. Gated as host.control:
# needs the system-control permission, NERVA_ACTION_KERNEL=1 and a GRANT; GET /api/power
# says why when it is refused. The desktop shell's NERVA_DESKTOP_BACKGROUND_THROTTLING
# (disabled | throttle | suspend; disabled by default) is read by the shell, not the hub.
NERVA_KEEP_AWAKE=0

# Required by NERVA_HARDENED=1: the audit chain is HMAC-keyed with it, so an attacker
# with DB write access cannot forge the chain. WITHOUT a key the chain is integrity-only,
# not tamper-evident — GET /api/security/audit/verify reports the difference.
# Keep this OFF-BOX (a password manager, not this repo, not the data root).
NERVA_AUDIT_KEY=

# Skill signing. Enforcement REQUIRES a key: without one the "signature" is a plain sha256
# an attacker can recompute and ship in their own SKILL.sig, so the gate would stop honest
# unsigned skills and not a deliberate one. Setting the flag with no key fails closed.
NERVA_REQUIRE_SIGNED_SKILLS=0
NERVA_SKILL_SIGNING_KEY=

# Encrypts backups AND the pre-forget archive. If unset, one is generated under
# $NERVA_KEY_DIR (default ~/.config/jarvis) — outside the data root, so a stolen archive
# never ships its own key.
NERVA_BACKUP_KEY=
NERVA_KEY_DIR=
# Archive-bomb caps when a backup is unpacked (verify drill + restore). A backup over
# either cap — or over the free space on the destination, counting the files an
# in-place --force restore replaces — fails loudly instead of filling the disk. Raise
# them only for a data root that genuinely exceeds them.
# default 1000000 members
NERVA_BACKUP_MAX_MEMBERS=
# default 68719476736 (64 GiB) uncompressed
NERVA_BACKUP_MAX_BYTES=

# 'Forget me' archives (POST /api/admin/forget). The archive is a complete copy of
# everything you asked to delete, so it is encrypted, kept outside the data root, and
# pruned. Default keeps only the newest.
# default: a sibling of the data root
NERVA_FORGET_ARCHIVE_DIR=
NERVA_FORGET_ARCHIVE_KEEP=1            # 0 = keep none

# H652 — save every completed model turn whole (system prompt, prompt, tool calls, tool
# results, reply) under <data root>/trajectories/<session>.jsonl, secrets redacted, for
# training export: GET /sessions/{id}/trajectories or `nerva sessions export ID --sharegpt`.
# Off by default: tool results can carry what you read through the hub.
NERVA_SAVE_TRAJECTORIES=0

# Telegram owner allowlist (comma-separated user ids). Empty is valid — sender pairing is
# the primary gate — but the approval-callback owner check needs either this or
# autonomy.owner_chat_id, and fails closed with neither.
TELEGRAM_ALLOWED_USER_IDS=
# Inbound pairing is ON by default: a sender the bot does not know is held until you pair
# them (HUD Pairing card or the t.me/<bot>?start=<token> link). 0 turns it off — then a
# channel with a token needs an allowlist above, or NERVA_CHANNEL_OPEN=1 to acknowledge
# an open bot (the boot log prints a [SECURITY] line); otherwise the box refuses to start.
NERVA_CHANNEL_PAIRING=1
NERVA_CHANNEL_OPEN=

# Group gating (Hermes absorption 0.4). In a group the bot answers only when it is @mentioned
# or replied to (TELEGRAM_GROUP_REQUIRE_MENTION=1, the default). TELEGRAM_ALLOWED_CHAT_IDS limits
# which groups it answers in at all (comma-separated chat ids, or chat_id:thread_id for one forum
# topic; empty = any group it is a member of). TELEGRAM_GROUP_OBSERVE=1 records unaddressed
# messages in allowed groups as conversation context without answering; 0 drops them entirely.
TELEGRAM_GROUP_REQUIRE_MENTION=1
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_GROUP_OBSERVE=0

# H23.4 live eval fidelity gate (owner box; all opt-in). With NERVA_EVAL_LIVE=1 the
# companion eval gate also runs the golden suite through your real local backend and
# fails closed if the lane cannot run. The model id has no default on purpose — the
# recorded baseline is per model. Floor 0.0 = regression-gated only.
NERVA_EVAL_LIVE=0
NERVA_EVAL_LIVE_URL=http://127.0.0.1:1234/v1   # LM Studio; Ollama: http://127.0.0.1:11434/v1
NERVA_EVAL_LIVE_MODEL=
NERVA_EVAL_LIVE_MIN_SCORE=0.0

# H613 voice command providers (owner box; opt-in). With NERVA_VOICE_COMMANDS=1 the TTS/STT
# command a human approved in Console -> Admin -> Settings -> Voice -> Command providers may run (argv only, never a
# shell). The timeout override is clamped to 1-600 s (defaults: 30 s TTS, 120 s STT).
# NERVA_VOICE_COMMANDS=1
# NERVA_VOICE_COMMAND_TIMEOUT_S=30

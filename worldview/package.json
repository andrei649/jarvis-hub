{
  "name": "worldview",
  "version": "0.1.0",
  "private": true,
  "description": "WorldView — 4D OSINT command center (monorepo root)",
  "workspaces": [
    "frontend",
    "backend-api"
  ],
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "db:apply": "for f in db/schema/*.sql; do psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f \"$f\"; done",
    "db:seed": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/seed/demo.sql",
    "seed:live": "node scripts/seed-live.mjs",
    "demo:feed": "node scripts/demo-feed.mjs",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:api": "npm run dev --workspace backend-api",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "//overrides": "deck.gl 9.3.x must resolve one consistent @deck.gl/core + @luma.gl stack, so the whole graph shares one Layer class. Keep these exact pins aligned with the frontend Deck.gl release.",
  "overrides": {
    "@deck.gl/core": "9.3.8",
    "@deck.gl/extensions": "9.3.8",
    "@deck.gl/mesh-layers": "9.3.8"
  }
}

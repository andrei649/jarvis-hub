      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "rps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (redpanda_topic) (rate(redpanda_kafka_records_produced_total[5m]))",
          "legendFormat": "produced {{redpanda_topic}}"
        }
      ]
    },
    {
      "title": "History-writer rows inserted/s (app metric)",
      "type": "timeseries",

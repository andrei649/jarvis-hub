# WorldView — shared environment template. Copy to .env and fill in.
# Each workspace also has its own scoped example (frontend/.env.local.example, etc.).

# --- Database (TimescaleDB + PostGIS) --------------------------------------
DATABASE_URL=postgres://worldview:worldview@localhost:5432/worldview

# --- Redis (live-state cache) ----------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Kafka / Redpanda ------------------------------------------------------
KAFKA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# --- External OSINT data sources (STEP 3 workers) --------------------------
# Fill in as you wire up each source; never commit real keys.
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
AISSTREAM_API_KEY=
SPACETRACK_USERNAME=
SPACETRACK_PASSWORD=

# --- Frontend basemap ------------------------------------------------------
MAPBOX_ACCESS_TOKEN=

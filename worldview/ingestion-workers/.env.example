# WorldView ingestion workers env. Copy to .env.
KAFKA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# --- ADS-B (Layer A) ---
ADSB_SOURCE=opensky          # opensky | adsbfi
ADSB_POLL_SECONDS=15
# OpenSky viewport "lamin,lomin,lamax,lomax" (empty = global; a bbox cuts API credit cost).
ADSB_BBOX=
# OpenSky OAuth2 client credentials (2025+ model; create at opensky-network.org account → API client).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# ADSB.fi is centered: "lat,lon" + radius (nm). Default = Strait of Hormuz AOI.
ADSB_CENTER=26.6,56.4
ADSB_RADIUS_NM=250

# --- AIS (Layer B) ---
AISSTREAM_API_KEY=
# AISStream bounding box "lat_sw,lon_sw,lat_ne,lon_ne" (empty = world; a box cuts volume).
AIS_BBOX=
AIS_RECONNECT_MAX_SECONDS=60

# --- TLE / Space (Layer C) ---
TLE_SOURCE=celestrak          # celestrak | spacetrack
TLE_GROUP=active              # Celestrak GROUP (active | visual | ...)
# Optional curated recon set (comma-separated NORAD ids); filters the fetched catalog.
TLE_NORAD_IDS=
TLE_PROPAGATE_SECONDS=60
TLE_REFRESH_SECONDS=10800
SPACETRACK_USERNAME=
SPACETRACK_PASSWORD=

# --- EW / Cyber (Layer D) ---
EW_SOURCE=gpsjam
GPSJAM_BASE_URL=https://gpsjam.org/data
EW_POLL_SECONDS=900

# --- Context (Layer E) ---
CONTEXT_EVENTS_URL=          # a GeoJSON FeatureCollection of events
CONTEXT_NOTAM_URL=           # NOTAM records (JSON list or {notams:[...]})
CONTEXT_POLL_SECONDS=300

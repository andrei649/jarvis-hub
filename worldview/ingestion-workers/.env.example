# WorldView ingestion workers env. Copy to .env.
KAFKA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# --- ADS-B (Layer A) ---
ADSB_SOURCE=opensky          # opensky | adsbfi
ADSB_POLL_SECONDS=15
# OpenSky viewport "lamin,lomin,lamax,lomax" (empty = global; a bbox cuts API credit cost).
ADSB_BBOX=
# OpenSky OAuth2 client credentials (2025+ model; create at opensky-network.org account → API client).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# ADSB.fi is centered: "lat,lon" + radius (nm). Default = Strait of Hormuz AOI.
ADSB_CENTER=26.6,56.4
ADSB_RADIUS_NM=250

# --- AIS (Layer B) ---
AISSTREAM_API_KEY=
# AISStream bounding box "lat_sw,lon_sw,lat_ne,lon_ne" (empty = world; a box cuts volume).
AIS_BBOX=
AIS_RECONNECT_MAX_SECONDS=60

# --- TLE / Space (Layer C) ---
TLE_SOURCE=celestrak          # celestrak | spacetrack
TLE_GROUP=active              # Celestrak GROUP (active | visual | ...)
# Optional curated recon set (comma-separated NORAD ids); filters the fetched catalog.
TLE_NORAD_IDS=
TLE_PROPAGATE_SECONDS=60
TLE_REFRESH_SECONDS=10800
SPACETRACK_USERNAME=
SPACETRACK_PASSWORD=

# --- Recon (Layer C insight) ---
# Predicts AOI coverage windows over the catalog -> osint.recon. Reuses TLE_* for the source;
# set TLE_NORAD_IDS to a curated recon set to bound CPU cost (it filters the fetched catalog).
RECON_INTERVAL_SECONDS=300     # how often to re-predict
RECON_HORIZON_SECONDS=86400    # look-ahead window (24h)
RECON_STEP_SECONDS=30          # coarse propagation step (s); finer = slower, more precise
# AOIs to predict: "id:lon,lat,radius_km;id2:..." (empty = a single Strait-of-Hormuz AOI).
AOIS=

# --- CEP (insight engine) ---
# Windowed-keyed complex-event-processing over the recon stream: buffers events into per-key
# (per-AOI) tumbling windows and fires the tipping detector once the watermark passes a window's
# close. Watermark = max_event_ts - CEP_LATENESS_SECONDS; events older than it are dropped.
CEP_INPUT_TOPICS=osint.recon   # comma-separated input topic(s) to consume
CEP_OUTPUT_TOPIC=osint.events  # topic for detected worldview.event.v1 messages
CEP_WINDOW_SECONDS=600         # tumbling window width (s)
CEP_LATENESS_SECONDS=120       # allowed lateness; out-of-order within this is still counted
CEP_TIPPING_DELTA_SECONDS=600  # tipping cluster max span (reused cep.tipping threshold)
CEP_TIPPING_MIN_COUNT=3        # tipping cluster min passes (reused cep.tipping threshold)

# --- Capture swarm (governed OSINT capture, H19.5.7) ---
# Snapshots EPHEMERAL signals (transient squawks, AIS gaps, RF spikes, expiring NOTAMs) to a TTL'd
# ephemeral cache, each stamped with provenance, under a token-bucket rate-limit (per-source AND
# global). Owns its own producer/topic. *_GLOBAL_* default to the per-source values if unset.
CAPTURE_TOPIC=osint.capture        # topic for worldview.capture.v1 snapshots
CAPTURE_INTERVAL_SECONDS=30        # how often a capture run gathers + governs candidates
CAPTURE_RATE_PER_SEC=5             # per-source token refill rate (tokens/sec)
CAPTURE_BURST=10                   # per-source bucket capacity (max burst)
CAPTURE_GLOBAL_RATE_PER_SEC=20     # global (all-sources) token refill rate (tokens/sec)
CAPTURE_GLOBAL_BURST=40            # global bucket capacity (max burst)
CAPTURE_CACHE_TTL_SECONDS=300      # snapshot TTL in the ephemeral cache (s)
CAPTURE_CACHE_CAPACITY=10000       # max live snapshots (drop-oldest beyond this)

# --- EW / Cyber (Layer D) ---
EW_SOURCE=gpsjam
GPSJAM_BASE_URL=https://gpsjam.org/data
EW_POLL_SECONDS=900

# --- Context (Layer E) ---
CONTEXT_EVENTS_URL=          # a GeoJSON FeatureCollection of events
CONTEXT_NOTAM_URL=           # NOTAM records (JSON list or {notams:[...]})
CONTEXT_POLL_SECONDS=300

# --- Load-test rig + as-of-T SLO (TOOL, not a worker; H19.1.6) ---
# Pumps synthetic telemetry at LOADTEST_TARGET_RATE msg/s for LOADTEST_DURATION_S seconds across
# LOADTEST_LAYERS (simulating LOADTEST_ENTITIES tracks/layer), then fires as-of-T
# GET {LOADTEST_API_URL}/history/:layer?t=&bbox= queries and measures the latency SLO.
# Run via `python -m worldview_ingest.loadtest`; it is NOT in WORKERS (it is a measurement tool).
LOADTEST_TARGET_RATE=100       # synthetic telemetry rate (msg/s)
LOADTEST_DURATION_S=60         # how long the produce phase runs (s)
LOADTEST_ENTITIES=500          # simulated tracks per layer (a finite, replayed fleet)
LOADTEST_LAYERS=adsb,ais       # comma-separated domains (adsb,ais,tle,ew,context)
LOADTEST_PROBE_COUNT=200       # number of as-of-T /history queries to time
LOADTEST_SLO_P95_S=0.5         # p95 as-of-T query latency SLO threshold (s)
LOADTEST_API_URL=http://localhost:8080  # backend base URL for /history/:layer

# WorldView frontend env. Copy to .env.local.
# Vite inlines VITE_* vars at build time and exposes them to the browser.

VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/live

# Cesium ion access token (https://ion.cesium.com — free tier). OPTIONAL: with no token the
# globe still renders a real Earth from the Natural Earth II tiles bundled inside the Cesium
# package — no account, no network fetch. A token upgrades the basemap to ion world imagery
# (photographic) plus world terrain (3D relief).
VITE_CESIUM_ION_TOKEN=

# Label for the AOI chip in the app bar.
VITE_AOI_LABEL=STRAIT OF HORMUZ

# Camera-tour waypoints: "Name,lon,lat,zoom[,dwellMs]" separated by ";". Unset = built-in AOIs.
VITE_TOUR_AOIS=

# H19.5.1 pre-aggregated tile service (CLIENT side). When zoomed out at/below TILE_MAX_ZOOM the
# globe draws server-aggregated tiles for adsb/ais as an imagery overlay instead of per-point
# marks, so it scales to 1M+ points. Leave VITE_TILE_URL empty to disable (per-point rendering).
#
# RASTER TEMPLATES ONLY: Cesium's imagery pipeline has no vector-tile decoder, so a `.pbf`/`.mvt`
# template is refused and the globe keeps rendering points. Point this at a raster endpoint, e.g.
#   VITE_TILE_URL=http://localhost:3002/adsb_live/{z}/{x}/{y}.png
VITE_TILE_URL=
VITE_TILE_MAX_ZOOM=6
VITE_TILE_MIN_ZOOM=0

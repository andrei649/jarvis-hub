# WorldView frontend env. Copy to .env.local.
# Public vars are exposed to the browser (NEXT_PUBLIC_ prefix).

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/live
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# H19.5.1 vector-tile service (CLIENT side). When zoomed out at/below TILE_MAX_ZOOM the globe
# renders server-aggregated MVT/raster tiles for adsb/ais instead of per-point layers, so it
# scales to 1M+ points. Leave NEXT_PUBLIC_TILE_URL empty to disable (today's point rendering).
# Point this at the local Martin / pg_tileserv docker-compose service, e.g.:
#   NEXT_PUBLIC_TILE_URL=http://localhost:3001/{z}/{x}/{y}.pbf
NEXT_PUBLIC_TILE_URL=
NEXT_PUBLIC_TILE_MAX_ZOOM=6
NEXT_PUBLIC_TILE_MIN_ZOOM=0

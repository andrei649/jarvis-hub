{
  "name": "@worldview/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Model Context Protocol server exposing the WorldView 4D OSINT REST API as MCP tools.",
  "main": "dist/server.js",
  "bin": {
    "worldview-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "tsx src/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "tsx": "^4.22.4",
    "typescript": "6.0.3"
  }
}
